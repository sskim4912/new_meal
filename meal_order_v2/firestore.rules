// 자동 생성: node scripts/build-firestore-rules.mjs
// 인증 없는 테스트 전용. 실제 개인정보를 저장하지 마세요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validProfile(d) {
      return d.group in ["gs","partner","vip"]
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.empId is string && d.company is string && d.phone is string
        && (d.group == 'gs'
          ? (d.empId.matches('^[A-Za-z0-9-]{1,30}$') && d.company == '' && d.phone == '')
          : (d.empId == '' && d.company.size() >= 1 && d.company.size() <= 80 && d.phone.matches('^[0-9]{8,15}$')));
    }
    function validMeal(d) {
      return (d.menu == "신청 안 함" && d.location == '')
        || (d.meal == 'lunch' && d.menu in ["백반"] && d.location in ["사무실","OSBL","ISBL"])
        || (d.meal == 'breakfast' && d.menu in ["샐러드(닭가슴살)","샐러드(오리훈제)","샐러드(치킨텐더)","샌드위치(매쉬포테이토)","샌드위치(치킨텐더)","볶음밥(김치)","볶음밥(중국식)"] && d.location == '')
        || (d.meal == 'dinner' && d.menu in ["샐러드(닭가슴살)","샐러드(오리훈제)","샐러드(치킨텐더)","샌드위치(매쉬포테이토)","샌드위치(치킨텐더)","볶음밥(김치)","볶음밥(중국식)"] && d.location == '');
    }
    function beforeDeadline(d) {
      let parts = d.date.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      let minutes = d.meal == 'breakfast' ? -1140 : d.meal == 'lunch' ? 0 : 300;
      return request.time < date + duration.value(minutes, 'm');
    }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/aurora_v2_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/aurora_v2_admins/$(request.auth.uid)).data.enabled == true;
    }
    function isProxy(d) {
      return d.keys().hasAll(['source']) && d.source == 'admin-proxy';
    }
    function beforeProxyDeadline(d) {
      let parts = d.date.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return request.time < date + duration.value(60, 'm');
    }
    function validProxy(d) {
      return isAdmin() && isProxy(d)
        && d.keys().hasAll(['id','requesterKey','group','empId','company','name','phone','date','meal','menu','location','updatedAt','source','quantity'])
        && d.keys().hasOnly(['id','requesterKey','group','empId','company','name','phone','date','meal','menu','location','updatedAt','source','quantity','operatorName'])
        && (!('operatorName' in d) || (d.operatorName is string && d.operatorName.size() >= 1 && d.operatorName.size() <= 40))
        && d.id is string && d.id.matches('^proxy:[A-Fa-f0-9-]{36}$')
        && d.requesterKey is string && d.requesterKey.size() <= 500
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.company is string && d.company.size() >= 1 && d.company.size() <= 80
        && d.empId == '' && d.phone == '' && d.group == 'vip'
        && d.meal == 'lunch' && d.location == '사무실' && d.quantity == 1
        && d.menu in ["백반"]
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.updatedAt == request.time && beforeProxyDeadline(d);
    }
    function validOrder(d) {
      return d.keys().hasAll(['id','requesterKey','group','empId','company','name','phone','date','meal','menu','location','updatedAt'])
        && d.keys().hasOnly(['id','requesterKey','group','empId','company','name','phone','date','meal','menu','location','updatedAt'])
        && d.id is string && d.id.size() <= 1000
        && d.requesterKey is string && d.requesterKey.size() <= 500
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.meal in ["breakfast","lunch","dinner"]
        && d.menu is string && d.location is string
        && d.updatedAt == request.time
        && validProfile(d) && validMeal(d) && beforeDeadline(d);
    }
    // 의도적으로 공개된 테스트 컬렉션입니다. 화면 비밀번호는 DB 접근을 막지 않습니다.
    match /aurora_v2_admins/{uid} { allow read, write: if false; }
    match /aurora_v2_orders/{orderId} {
      allow read: if true;
      allow create: if validOrder(request.resource.data) || validProxy(request.resource.data);
      allow update: if isProxy(resource.data)
        ? (beforeProxyDeadline(resource.data) && validProxy(request.resource.data))
        : validOrder(request.resource.data);
      allow delete: if !isProxy(resource.data) || (isAdmin() && beforeProxyDeadline(resource.data));
    }
  }
}
